# Só é necessário para ler planilhas reais com login. Sem este arquivo, o app abre a demonstração.
# Copie para .streamlit/secrets.toml (local) ou cole em Settings > Secrets no Streamlit Cloud.
# O secrets.toml real nunca vai para o repositório.

# Login com Google (OIDC)
[auth]
redirect_uri = "https://SEU-APP.streamlit.app/oauth2callback"   # local: http://localhost:8501/oauth2callback
cookie_secret = "gere-uma-string-aleatoria-longa"                 # python -c "import secrets;print(secrets.token_urlsafe(48))"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Quem pode entrar
[acesso]
dominios = []                                  # ex.: ["empresa.com.br"] libera o domínio inteiro
emails = ["nome.sobrenome@empresa.com.br"]

# IDs das planilhas (o trecho entre /d/ e /edit no link)
[planilhas]
followup = "ID-da-planilha-follow-up"
encerrados = "ID-da-planilha-de-encerrados"
tarifas = "ID-da-planilha-de-tarifas"

# Conta de serviço com acesso de leitura às planilhas (conteúdo do JSON do Google Cloud)
[gcp_service_account]
type = "service_account"
project_id = "seu-projeto"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "painel-logistico@seu-projeto.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
